{
    "geode": "5.8.1",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081"
    },
    "version": "1.0.0-alpha",
    "id": "kwaita.type-to-click", 
    "name": "type to click",
    "developer": "kwaita",
    "tags": ["gameplay", "joke"],
    "description": "Replaces jumping with typing words.",
    "links": {
        "source": "https://github.com/kwaita/type-to-click"
    },
    "settings": {
        "enabled": {
            "name": "Enabled",
            "description": "Require typing words to jump",
            "type": "bool",
            "default": true
        },
        "click-word": {
            "name": "Click Word",
            "description": "type ts to press for 1 frame",
            "type": "string",
            "default": "hop"
        },
        "hold-word": {
            "name": "Hold Word",
            "description": "Type ts to hold jump",
            "type": "string",
            "default": "hold"
        },
        "release-word": {
            "name": "Release Word",
            "description": "Type ts to release jump",
            "type": "string",
            "default": "unhold"
        },
        "tempo-hold-word": {
            "name": "Tempo Hold Word",
            "description": "Type ts to hold jump for 1 second",
            "type": "string",
            "default": "wee"
        }
    }
}
